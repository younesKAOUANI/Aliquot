# Production environment. Copy to /etc/aliquot/aliquot.env on the VPS, fill in
# the secrets, and `chmod 600` it — it is the only place they exist.
#
#   sudo install -d -m 750 /etc/aliquot
#   sudo cp aliquot.env.example /etc/aliquot/aliquot.env
#   sudo chown root:deploy /etc/aliquot/aliquot.env
#   sudo chmod 640 /etc/aliquot/aliquot.env
#
# 640 with group `deploy`, not 600: deploy.sh runs as that user and hands this
# file to `docker compose --env-file`, which reads it as the invoking user.
#
# Generate each secret rather than inventing one:
#   openssl rand -hex 32     # AUTH_JWT_SECRET, POSTGRES_PASSWORD, APP_DB_PASSWORD
#
# Hex, not base64, for the database passwords: they are interpolated into
# postgres://user:password@host/db, and base64 can emit '/', which ends the
# userinfo section and yields 'TypeError: Invalid URL' at API startup. migrate.ts
# rejects a URL-unsafe APP_DB_PASSWORD rather than letting it get that far.
#
# This file is read by docker compose and by deploy.sh. It is never committed
# and never leaves the box.

# Deliberately absent: the public hostname and the ACME contact. This stack no
# longer terminates TLS — the shared edge Caddy does, for all three sites on the
# box. See the `edge` directory of the portfolio repository.

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# Set by deploy.sh to the exact tag being shipped. The default here is only for
# a manual first boot.
ALIQUOT_IMAGE=ghcr.io/youneskaouani/aliquot:latest

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The owner. Used only by the migration runner and by backup/restore.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=aliquot

# The unprivileged login role the API and worker connect as. Created by
# scripts/migrate.ts; NOINHERIT, no BYPASSRLS, not a superuser. The service
# asserts all three at startup and refuses to boot otherwise, because a
# privileged role disables tenant isolation while every test still passes.
APP_DB_USER=aliquot_login
APP_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# Cloudflare R2. The application speaks S3 and nothing else, so AWS S3 or any
# other S3-compatible endpoint works by changing these five values.
#
# The account endpoint, NOT the public bucket URL. Find it under R2 → your
# bucket → Settings → S3 API.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_BUCKET=aliquot
# An R2 API token scoped to Object Read & Write on this bucket alone.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_REGION=auto

# Why not a bundled MinIO on the box: a presigned URL is signed for a specific
# host, so the browser doing the upload and the worker reading the bytes back
# have to resolve that host to the same store. Self-hosting the object store
# means giving it a public name and a certificate to satisfy that constraint,
# and then owning durability for a single disk that the nightly database dump
# does not cover. R2's endpoint already resolves identically from everywhere and
# the constraint disappears.
#
# CORS matters and is easy to miss: the bucket must allow PUT and GET from
# https://aliquot.youneskaouani.dev, or browser uploads fail with an opaque
# network error while curl against the same presigned URL succeeds.

STORAGE_PRESIGN_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# 32+ bytes. Rotating it invalidates every issued session, which is the point.
AUTH_JWT_SECRET=

# Deliberately absent: AUTH_DEV_TOKEN_ENDPOINT. It mints a session for any email
# address, the service refuses to start with it on in production, and Caddy
# returns 404 for the route regardless. Three layers, none of them accidental.

# Read-only public demo. Takes no request body, mints a session for exactly the
# account below, and every mutating verb is refused by DemoReadOnlyGuard.
# See ADR-0020.
DEMO_MODE=true
DEMO_TENANT_SLUG=acme
DEMO_USER_EMAIL=priya.venkat@acme.test
DEMO_TOKEN_TTL_SECONDS=3600
DEMO_RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Ephemeral sandbox tenants
# ---------------------------------------------------------------------------
# POST /v1/sandbox takes no request body and creates a whole disposable tenant --
# study, operator, instrument, grants -- then hands back an ORDINARY operator
# session for it. Not a demo session: it can write, and every role check applies
# to it exactly as to a paying tenant. On this deployment it is the difference
# between a visitor reading that corrupt bytes are caught and a visitor watching
# it happen to bytes they corrupted themselves. See ADR-0021.
#
# On beside DEMO_MODE, not instead of it. The demo shows the seeded dataset; the
# sandbox lets a stranger produce one.
#
# This is the only feature here that lets an anonymous caller write. What bounds
# it is the quota below, the rate limit, and the expiry -- after which
# SandboxReaper, in the WORKER process, deletes the tenant outright. That is the
# only deletion in this service; aliquot.reap_sandbox_tenant() refuses any tenant
# whose kind is not 'sandbox' before it touches a row.
SANDBOX_MODE=true
# An hour is long enough to read the walkthrough while a sandbox is open, and
# short enough that the storage below is rented rather than bought. The database
# refuses anything over 1440 regardless of what is written here.
SANDBOX_TTL_MINUTES=60
SANDBOX_MAX_RUNS=5
# Per declared artifact, refused at registration before any upload URL exists.
SANDBOX_MAX_ARTIFACT_BYTES=8388608
# Across the tenant, and the number to reason about when reasoning about cost:
# the R2 exposure is live sandboxes x this, so at these values a hundred
# concurrent visitors is at most ~3 GiB held for at most an hour. Must be at
# least SANDBOX_MAX_ARTIFACT_BYTES or the service refuses to start. There is no
# global cap on live sandboxes; if this deployment is ever abused, that is the
# thing to add, not a smaller number here.
SANDBOX_MAX_TOTAL_BYTES=33554432
# Six a minute per source address, well below the demo's twenty, because each
# admitted request creates a tenant and an audit chain rather than a session. The
# limiter is in memory and per instance (ADR-0020), so this holds only while this
# stack runs one API container.
SANDBOX_RATE_LIMIT_PER_MINUTE=6
# Sweep interval, not a safety property: an expired sandbox is already refused
# every write by SandboxQuotaGuard, so a late sweep costs storage and nothing
# else. Five minutes keeps the worker's polling cheap.
SANDBOX_REAP_INTERVAL_MS=300000

# CORS again, and it bites here rather than on the demo: a sandbox visitor
# uploads bytes, and a presigned PUT goes from their browser straight to R2. If
# the bucket does not allow PUT from https://aliquot.youneskaouani.dev the upload
# fails with an opaque network error and no useful message anywhere -- the same
# request from curl succeeds, which makes it look like a browser bug rather than
# a bucket policy.

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Two is right for one small box: the worker is I/O bound on storage reads and
# more concurrency mostly buys contention on the connection pool.
WORKER_CONCURRENCY=2
BACKUP_DIR=/var/backups/aliquot
BACKUP_RETAIN_DAYS=14
