# Copy to .env for running outside docker compose. Compose supplies these itself.
#
# There are two database URLs on purpose. DATABASE_ADMIN_URL owns the schema and
# is used only by scripts/migrate.ts. DATABASE_URL is the unprivileged login
# role the service runs as -- it is NOINHERIT and holds no table privileges of
# its own, so every transaction must SET LOCAL ROLE into aliquot_app or
# aliquot_worker. The service asserts at startup that this role is not a
# superuser and does not have BYPASSRLS, and refuses to boot if it is, because
# a privileged role silently disables tenant isolation while every test still
# passes.

NODE_ENV=development
SERVICE_ROLE=api
PORT=3000
LOG_LEVEL=info

# Host ports published by docker compose. Only needed when something else on
# the machine already holds one of the defaults; the container-side ports never
# change, so nothing inside the stack is affected.
ALIQUOT_API_PORT=3000
ALIQUOT_POSTGRES_PORT=5433
ALIQUOT_MINIO_PORT=9000
ALIQUOT_MINIO_CONSOLE_PORT=9001

DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/aliquot
DATABASE_URL=postgres://aliquot_login:aliquot-dev-secret@localhost:5433/aliquot
DATABASE_POOL_SIZE=10
DATABASE_LOG_QUERIES=false

# Created by scripts/migrate.ts when both are present.
APP_DB_USER=aliquot_login
APP_DB_PASSWORD=aliquot-dev-secret

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=aliquot
STORAGE_ACCESS_KEY_ID=aliquot
STORAGE_SECRET_ACCESS_KEY=aliquot-dev-secret
# MinIO requires path-style addressing; real S3 does not.
STORAGE_FORCE_PATH_STYLE=true
# Presigned URLs are capability tokens. Short enough to bound exposure, long
# enough for a large part to finish on a lab network.
STORAGE_PRESIGN_TTL_SECONDS=3600
STORAGE_PART_SIZE_BYTES=67108864

# Development-grade session tokens. A real deployment federates to an OIDC
# provider; the Principal boundary is where that swap happens.
AUTH_JWT_SECRET=development-only-secret-not-for-any-real-deployment
AUTH_TOKEN_TTL_SECONDS=3600
# Enables POST /v1/auth/token. The service refuses to start with this on when
# NODE_ENV=production, because it is a complete authentication bypass.
AUTH_DEV_TOKEN_ENDPOINT=true

# Read-only public demo (ADR-0020). Unlike AUTH_DEV_TOKEN_ENDPOINT this IS
# permitted in production: POST /v1/auth/demo takes no request body and mints a
# session for exactly the account below, marked demo:true and refused on every
# mutating verb by DemoReadOnlyGuard. There is nothing a caller can influence
# and no way to enumerate accounts, which is what makes it publishable.
#
# The service refuses to start with this and AUTH_DEV_TOKEN_ENDPOINT both
# enabled -- different mechanisms with different threat models, and running both
# signals a misconfiguration rather than a preference. So this is off here and
# on in deploy/aliquot.env.example.
DEMO_MODE=false
DEMO_TENANT_SLUG=acme
# Must exist in that tenant, or the endpoint answers 503 rather than minting
# anything. The seeded steward, because POST /v1/audit/verify requires steward
# or admin and chain verification is the thing most worth showing.
DEMO_USER_EMAIL=priya.venkat@acme.test
DEMO_TOKEN_TTL_SECONDS=3600
DEMO_RATE_LIMIT_PER_MINUTE=20

# Ephemeral sandbox tenants. POST /v1/sandbox takes no request body and creates
# a whole disposable tenant -- study, operator, instrument, grants -- then hands
# back an ORDINARY operator session for it. Not a demo session: it can write, and
# every role check applies to it exactly as it does to a paying tenant.
#
# Deliberately NOT mutually exclusive with DEMO_MODE. The demo shows the seeded
# dataset; the sandbox lets a visitor produce one, catch a corrupted byte, and
# watch the run quarantine. Normally both are on.
#
# Containment is the quota below plus the expiry: SandboxReaper runs in the
# WORKER process and deletes an expired sandbox outright -- rows and objects.
# That is the only deletion in this service, and migration 0008 is where it is
# argued for. A sandbox is explicitly outside the enduring record.
SANDBOX_MODE=false
# Minutes until the reaper takes it, and the only thing that bounds a visitor's
# storage over time. Capped at 1440 by the database as well as here, because the
# database ceiling is the point at which "ephemeral" stops being true and a
# number in an environment file is easy to raise without thinking about it.
SANDBOX_TTL_MINUTES=60
# Enough to register a run, watch it quarantine, and then do it properly, with
# room to spare. A visitor who wants more asks for another sandbox, which costs
# them one request and costs this deployment a bounded tenant rather than an
# unbounded one.
SANDBOX_MAX_RUNS=5
# Per declared artifact, refused at registration before any upload URL is
# issued -- refusing after the bytes have landed is a report on a quota, not one.
SANDBOX_MAX_ARTIFACT_BYTES=8388608
# Across the tenant. Must be at least SANDBOX_MAX_ARTIFACT_BYTES, or the service
# refuses to start: otherwise no artifact of the permitted size could ever be
# uploaded and the first failure would blame the wrong limit.
SANDBOX_MAX_TOTAL_BYTES=33554432
# Lower than the demo's, because each admitted request creates a tenant.
SANDBOX_RATE_LIMIT_PER_MINUTE=6
# How often the worker sweeps for expired sandboxes. This is scheduling, not
# safety -- a sandbox that outlives its expiry by a few minutes has already been
# refused every write by SandboxQuotaGuard -- so the interval trades a little
# storage against a connection spent polling.
SANDBOX_REAP_INTERVAL_MS=300000

IDEMPOTENCY_RETENTION_HOURS=24

WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=300

AUDIT_CHECKPOINT_INTERVAL_MS=300000
AUDIT_CHECKPOINT_MIN_EVENTS=50
