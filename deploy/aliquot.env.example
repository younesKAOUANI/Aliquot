# Production environment. Copy to /etc/aliquot/aliquot.env on the VPS, fill in
# the secrets, and `chmod 600` it — it is the only place they exist.
#
#   sudo install -d -m 750 /etc/aliquot
#   sudo cp aliquot.env.example /etc/aliquot/aliquot.env
#   sudo chmod 600 /etc/aliquot/aliquot.env
#
# Generate each secret rather than inventing one:
#   openssl rand -hex 32     # AUTH_JWT_SECRET
#   openssl rand -base64 24  # database and storage passwords
#
# This file is read by docker compose and by deploy.sh. It is never committed
# and never leaves the box.

# ---------------------------------------------------------------------------
# Hostnames
# ---------------------------------------------------------------------------
ALIQUOT_DOMAIN=aliquot.youneskaouani.dev
# Object storage needs its own public name. A presigned URL is signed for a
# specific host, and the browser uploading and the worker reading back must both
# resolve it identically — see docs/DEPLOYMENT.md.
STORAGE_DOMAIN=storage.aliquot.youneskaouani.dev
# Where Let's Encrypt sends expiry warnings. A real address you read.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# Set by deploy.sh to the exact tag being shipped. The default here is only for
# a manual first boot.
ALIQUOT_IMAGE=ghcr.io/youneskaouani/aliquot:latest

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The owner. Used only by the migration runner and by backup/restore.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=aliquot

# The unprivileged login role the API and worker connect as. Created by
# scripts/migrate.ts; NOINHERIT, no BYPASSRLS, not a superuser. The service
# asserts all three at startup and refuses to boot otherwise, because a
# privileged role disables tenant isolation while every test still passes.
APP_DB_USER=aliquot_login
APP_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# Two supported shapes. Pick one; the application does not care which.
#
# (a) Bundled MinIO, exposed at STORAGE_DOMAIN through Caddy. No external
#     account. You own durability: single-node MinIO on one disk means one disk
#     is the whole story, so take the volume backups in docs/DEPLOYMENT.md
#     seriously.
BUNDLED_STORAGE=true
STORAGE_ENDPOINT=https://storage.aliquot.youneskaouani.dev
STORAGE_BUCKET=aliquot
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_REGION=us-east-1
#
# (b) Cloudflare R2 or AWS S3. Set BUNDLED_STORAGE=false, comment out the
#     STORAGE_DOMAIN block in the Caddyfile, drop that DNS record, and:
#
#   BUNDLED_STORAGE=false
#   STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   STORAGE_BUCKET=aliquot
#   STORAGE_ACCESS_KEY_ID=<r2 access key>
#   STORAGE_SECRET_ACCESS_KEY=<r2 secret>
#   STORAGE_FORCE_PATH_STYLE=true
#   STORAGE_REGION=auto
#
#     Nothing else changes. The presigned-URL constraint disappears entirely
#     because their endpoint already resolves the same way from everywhere.

STORAGE_PRESIGN_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# 32+ bytes. Rotating it invalidates every issued session, which is the point.
AUTH_JWT_SECRET=

# Deliberately absent: AUTH_DEV_TOKEN_ENDPOINT. It mints a session for any email
# address, the service refuses to start with it on in production, and Caddy
# returns 404 for the route regardless. Three layers, none of them accidental.

# Read-only public demo. Takes no request body, mints a session for exactly the
# account below, and every mutating verb is refused by DemoReadOnlyGuard.
# See ADR-0020.
DEMO_MODE=true
DEMO_TENANT_SLUG=acme
DEMO_USER_EMAIL=priya.venkat@acme.test
DEMO_TOKEN_TTL_SECONDS=3600
DEMO_RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Two is right for one small box: the worker is I/O bound on storage reads and
# more concurrency mostly buys contention on the connection pool.
WORKER_CONCURRENCY=2
BACKUP_DIR=/var/backups/aliquot
BACKUP_RETAIN_DAYS=14
